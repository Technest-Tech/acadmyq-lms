# ── apps/wa-gateway env (production) ──────────────────────────────────────────
# Copy to /etc/wa-gateway/wa-gateway.env on the gateway droplet (chmod 600, owner wagateway)
# and fill the {{...}} values. Secrets must MATCH the app droplet's apps/api/.env:
#   GATEWAY_ADMIN_SECRET   == WA_GATEWAY_ADMIN_SECRET
#   WEBHOOK_SIGNING_SECRET == WA_WEBHOOK_SECRET
NODE_ENV=production

# Bind to the VPC PRIVATE interface IP so the gateway is unreachable from the public internet.
# {{GATEWAY_PRIVATE_IP}} e.g. 10.116.0.5
BIND_ADDR={{GATEWAY_PRIVATE_IP}}
PORT=8088

# Gateway's own LOCAL Postgres (created by provision-wa-gateway.sh).
DATABASE_URL=postgres://wagateway:{{WA_DB_PASSWORD}}@127.0.0.1:5432/wa_gateway

GATEWAY_ADMIN_SECRET={{WA_GATEWAY_ADMIN_SECRET}}
WEBHOOK_SIGNING_SECRET={{WA_WEBHOOK_SECRET}}
# Where Laravel receives webhooks (public HTTPS endpoint on the app droplet).
# NOTE the /api prefix — Laravel serves routes/api.php under /api.
LARAVEL_WEBHOOK_URL=https://api.acadmyq.com/api/internal/wa/webhook

LOG_LEVEL=info

# ── Anti-ban send pacing (per session) ──────────────────────────────────────
SEND_MIN_INTERVAL_MS=6000
SEND_MAX_INTERVAL_MS=15000
SEND_DAILY_CAP=500
WARMUP_DAYS=3
WARMUP_DAILY_CAP=40
WARMUP_MIN_INTERVAL_MS=20000
WARMUP_MAX_INTERVAL_MS=45000

# ── Reconnection / health ───────────────────────────────────────────────────
KEEPALIVE_MS=10000
RECONNECT_BASE_MS=1000
RECONNECT_CAP_MS=60000
WATCHDOG_INTERVAL_MS=30000
WATCHDOG_STALE_MS=90000
