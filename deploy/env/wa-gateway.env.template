# ── apps/wa-gateway env (production) ──────────────────────────────────────────
# Copy to /etc/wa-gateway/wa-gateway.env on the gateway droplet (chmod 600, owner wagateway)
# and fill the {{...}} values. Secrets must MATCH the app droplet's apps/api/.env:
#   GATEWAY_ADMIN_SECRET   == WA_GATEWAY_ADMIN_SECRET
#   WEBHOOK_SIGNING_SECRET == WA_WEBHOOK_SECRET
NODE_ENV=production

# Bind to the VPC PRIVATE interface IP so the gateway is unreachable from the public internet.
# {{GATEWAY_PRIVATE_IP}} e.g. 10.116.0.5
BIND_ADDR={{GATEWAY_PRIVATE_IP}}
PORT=8088

# Gateway's own LOCAL Postgres (created by provision-wa-gateway.sh).
DATABASE_URL=postgres://wagateway:{{WA_DB_PASSWORD}}@127.0.0.1:5432/wa_gateway

GATEWAY_ADMIN_SECRET={{WA_GATEWAY_ADMIN_SECRET}}
WEBHOOK_SIGNING_SECRET={{WA_WEBHOOK_SECRET}}
# Where Laravel receives webhooks (public HTTPS endpoint on the app droplet).
# NOTE the /api prefix — Laravel serves routes/api.php under /api.
LARAVEL_WEBHOOK_URL=https://api.acadmyq.com/api/internal/wa/webhook

LOG_LEVEL=info

# ── Anti-ban send pacing (per session) ──────────────────────────────────────
SEND_MIN_INTERVAL_MS=6000
SEND_MAX_INTERVAL_MS=15000
SEND_DAILY_CAP=500
WARMUP_DAYS=3
WARMUP_DAILY_CAP=40
WARMUP_MIN_INTERVAL_MS=20000
WARMUP_MAX_INTERVAL_MS=45000
# After the warm-up, the cap and gaps climb to the full profile over this many days (no overnight jump).
RAMP_DAYS=11
# Rest REST_MIN..REST_MAX ms after every BURST_MIN..BURST_MAX messages.
BURST_MIN=15
BURST_MAX=30
REST_MIN_MS=45000
REST_MAX_MS=120000
# A queued message older than this fails as "expired" instead of going out late (12h).
QUEUE_MAX_AGE_MS=43200000
SEND_TIMEOUT_MS=60000
# Ask WhatsApp whether a number exists before the first message to it. Set false to switch off.
CHECK_RECIPIENTS=true
# The brake: this many refusals in a row pause the number's queue for BRAKE_PAUSE_MS (30 min);
# a restriction answer (463) pauses it for BRAKE_RESTRICTED_PAUSE_MS (6h).
BRAKE_ERROR_STREAK=5
BRAKE_PAUSE_MS=1800000
BRAKE_RESTRICTED_PAUSE_MS=21600000

# ── Reconnection / health ───────────────────────────────────────────────────
# Was 10000: Baileys drops a socket silent for KEEPALIVE_MS + 5s, so 10s tore healthy sessions down
# on any 15s network hiccup.
KEEPALIVE_MS=25000
RECONNECT_BASE_MS=1000
RECONNECT_CAP_MS=60000
# After RECONNECT_SLOW_AFTER failed dials in a row, retry at most every RECONNECT_SLOW_CAP_MS.
RECONNECT_SLOW_AFTER=10
RECONNECT_SLOW_CAP_MS=300000
# An unpaired session shows QR codes for this long, then waits for the next Connect press.
QR_MAX_WAIT_MS=600000
# A linked number that stays off this long is reported to the app (Slack alert).
DOWN_ALERT_MS=900000
WATCHDOG_INTERVAL_MS=30000
WATCHDOG_STALE_MS=90000

# ── Proxies (one address per academy) ───────────────────────────────────────
# Empty = every number dials WhatsApp from this server's own address (as before).
# Set to a comma-separated list and each academy is pinned to one proxy for good:
#   PROXY_URLS=http://user:pass@1.2.3.4:8000,socks5://user:pass@5.6.7.8:1080
# STATIC addresses only (static residential / ISP). Never a rotating pool: a number whose address
# changes mid-session is worse off than one on a datacenter IP. A proxy that is down takes its
# numbers down with it — there is no fallback to the server's address, on purpose.
PROXY_URLS=

# ── Backups (deploy/bin/wa-gateway-backup.sh, hourly from /etc/cron.d) ──────
# rsync target for a copy off this server, e.g. backup@10.0.0.2:/var/backups/wa-gateway/
# Empty = dumps stay on this server only, which does not survive losing this server.
WA_BACKUP_REMOTE=
