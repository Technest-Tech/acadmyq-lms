# ── apps/web/.env.production ──────────────────────────────────────────────────
# Copy to /var/www/acadmyq/apps/web/.env.production on the droplet.
# NEXT_PUBLIC_* values are inlined at BUILD time, so set these before `pnpm build`.
NEXT_PUBLIC_API_URL=https://api.acadmyq.com
NEXT_PUBLIC_AUTH_MODE=cookie

# LMS learner-site subdomain routing (docs/lms/02). Without this the middleware is a pass-through
# and `<academy>.acadmyq.com` serves the main app instead of that client's course site.
# Mirror of the API's LMS_SITE_ROOT_DOMAIN. Scheme defaults to https; only override locally.
NEXT_PUBLIC_ROOT_DOMAIN=acadmyq.com
