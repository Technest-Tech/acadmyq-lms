# ── apps/api/.env (production) ────────────────────────────────────────────────
# Copy to /var/www/acadmyq/apps/api/.env on the droplet and fill the {{...}} values.
# {{APP_KEY}}     → php artisan key:generate --show   (or reuse existing)
# {{DB_PASSWORD}} → value stored in /root/acadmyq-secrets.env
APP_NAME=Acadmyq
APP_ENV=production
APP_KEY={{APP_KEY}}
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.acadmyq.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ── Database: local PostgreSQL on the droplet ────────────────────────────────
DB_CONNECTION=pgsql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=academiq
DB_USERNAME=academiq_app
DB_PASSWORD={{DB_PASSWORD}}
DB_RLS_BYPASS_ROLE=academiq_rls_bypass

# ── Session / Sanctum cross-subdomain cookie auth ────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_TABLE=user_sessions
SESSION_DOMAIN=.acadmyq.com
SESSION_SECURE_COOKIE=true

FRONTEND_URL=https://acadmyq.com
# Wildcard covers every academy subdomain; apex + app listed explicitly.
SANCTUM_STATEFUL_DOMAINS=acadmyq.com,app.acadmyq.com,*.acadmyq.com

QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail: configure a real SMTP relay before relying on notifications ────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="no-reply@acadmyq.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Self-hosted WhatsApp gateway (apps/wa-gateway, separate droplet) ─────────
# Reach the gateway over the DigitalOcean VPC PRIVATE network — never its public IP.
# {{WA_GATEWAY_PRIVATE_URL}} e.g. http://10.116.0.5:8088
# SEND surface (WasenderClient) + LIFECYCLE surface (GatewayAdminClient) share this base URL.
WASENDER_BASE_URL={{WA_GATEWAY_PRIVATE_URL}}
WASENDER_TIMEOUT=15
WA_GATEWAY_URL={{WA_GATEWAY_PRIVATE_URL}}
# Must match GATEWAY_ADMIN_SECRET / WEBHOOK_SIGNING_SECRET on the gateway droplet.
WA_GATEWAY_ADMIN_SECRET={{WA_GATEWAY_ADMIN_SECRET}}
WA_WEBHOOK_SECRET={{WA_WEBHOOK_SECRET}}
WA_GATEWAY_TIMEOUT=15
