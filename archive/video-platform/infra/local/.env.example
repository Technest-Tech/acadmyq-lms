# Copy to .env to override defaults.  cp .env.example .env

# IP that LiveKit advertises in ICE candidates:
#   127.0.0.1            → two browser tabs on THIS machine (default)
#   192.168.x.x (LAN IP) → two real devices on the same WiFi
# Find your LAN IP:  ipconfig getifaddr en0   (macOS)
LIVEKIT_NODE_IP=127.0.0.1
