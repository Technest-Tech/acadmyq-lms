# pnpm 10+/11 block dependency build scripts by default and exit non-zero in CI
# when any are ignored. The packages we use (sharp, @swc/core, …) ship prebuilt
# binaries, so a non-zero exit here is spurious — downgrade it to a warning.
# Specific scripts that SHOULD run are allow-listed in pnpm-workspace.yaml.
strict-dep-builds=false
