{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "title": "AcademIQ Media — Overview",
  "uid": "academiq-media",
  "tags": ["academiq", "livekit"],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "panels": [
    {
      "type": "stat",
      "title": "LiveKit up",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "academiq-prom" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] }, "overrides": [] },
      "targets": [{ "expr": "up{job=\"livekit\"}", "refId": "A", "datasource": { "type": "prometheus", "uid": "academiq-prom" } }]
    },
    {
      "type": "stat",
      "title": "node_exporter up",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "academiq-prom" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] }, "overrides": [] },
      "targets": [{ "expr": "up{job=\"node\"}", "refId": "A", "datasource": { "type": "prometheus", "uid": "academiq-prom" } }]
    },
    {
      "type": "timeseries",
      "title": "CPU usage %",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "academiq-prom" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [{ "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "refId": "A", "legendFormat": "cpu", "datasource": { "type": "prometheus", "uid": "academiq-prom" } }]
    },
    {
      "type": "timeseries",
      "title": "Memory + Swap usage %",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "academiq-prom" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        { "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100", "refId": "A", "legendFormat": "memory", "datasource": { "type": "prometheus", "uid": "academiq-prom" } },
        { "expr": "(1 - (node_memory_SwapFree_bytes / node_memory_SwapTotal_bytes)) * 100", "refId": "B", "legendFormat": "swap", "datasource": { "type": "prometheus", "uid": "academiq-prom" } }
      ]
    },
    {
      "type": "timeseries",
      "title": "Network throughput (eth0)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "academiq-prom" },
      "fieldConfig": { "defaults": { "unit": "bps" }, "overrides": [] },
      "targets": [
        { "expr": "rate(node_network_receive_bytes_total{device=\"eth0\"}[5m]) * 8", "refId": "A", "legendFormat": "rx", "datasource": { "type": "prometheus", "uid": "academiq-prom" } },
        { "expr": "rate(node_network_transmit_bytes_total{device=\"eth0\"}[5m]) * 8", "refId": "B", "legendFormat": "tx", "datasource": { "type": "prometheus", "uid": "academiq-prom" } }
      ]
    },
    {
      "type": "timeseries",
      "title": "Disk free % (/)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "academiq-prom" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [{ "expr": "(node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100", "refId": "A", "legendFormat": "free", "datasource": { "type": "prometheus", "uid": "academiq-prom" } }]
    }
  ]
}
