# AcademIQ Video — PRODUCTION env contract.
# Copy to `.env` on the server (root-only: chmod 600), fill REAL values. NEVER commit the real .env.
# This file documents every variable + WHERE it is consumed. Placeholders only.
#
# Generate secrets on the box:
#   LIVEKIT_API_KEY:        openssl rand -hex 8      (short, public-ish key id, e.g. APIxxxxxxxx)
#   LIVEKIT_API_SECRET:     openssl rand -base64 48  (>= 32 chars)
#   TURN_STATIC_AUTH_SECRET openssl rand -hex 32
#   REDIS_PASSWORD:         openssl rand -hex 24
#   GRAFANA_ADMIN_PASSWORD: openssl rand -base64 24

# ── Identity / DNS ────────────────────────────────────────────────────────────
DOMAIN_MEDIA=media.acadmyq.com          # LiveKit signaling (WSS) via Caddy
DOMAIN_TURN=turn.acadmyq.com            # coturn realm + TLS SNI
EXTERNAL_IP=159.223.184.102             # droplet public IPv4 (advertised in ICE + coturn relay)
ACME_EMAIL=admin@acadmyq.com            # Let's Encrypt registration (expiry notices)

# ── LiveKit keys (mirror EXACTLY into the Laravel app env) ─────────────────────
LIVEKIT_API_KEY=REPLACE_api_key
LIVEKIT_API_SECRET=REPLACE_api_secret_min_32_chars
# Webhook signing — LiveKit signs webhook POSTs to the Laravel API with this key pair.
# provision.sh defaults these to LIVEKIT_API_KEY/SECRET (the API verifies with the same secret).
LIVEKIT_WEBHOOK_API_KEY=REPLACE_api_key
LIVEKIT_WEBHOOK_API_SECRET=REPLACE_api_secret_min_32_chars
# Where LiveKit POSTs room/participant/egress webhooks (the Laravel control plane).
WEBHOOK_URL=https://api.acadmyq.com/internal/livekit/webhook

# ── Redis (localhost-only; password as defense-in-depth) ──────────────────────
REDIS_PASSWORD=REPLACE_redis_password

# ── coturn (standalone TURN) ──────────────────────────────────────────────────
TURN_REALM=turn.acadmyq.com
TURN_STATIC_AUTH_SECRET=REPLACE_turn_shared_secret   # shared with LiveKit rtc.turn_servers
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# ── Recording / Egress → durable object storage (S3-compatible) ───────────────
# Provider TBD (Backblaze B2 / Wasabi / DO Spaces). Bucket created by the user.
REC_S3_ENDPOINT=REPLACE_https_endpoint        # e.g. https://s3.us-west-002.backblazeb2.com
REC_S3_REGION=REPLACE_region                  # e.g. us-west-002
REC_S3_BUCKET=academiq-recordings
REC_S3_ACCESS_KEY=REPLACE_access_key
REC_S3_SECRET=REPLACE_secret_key
REC_S3_FORCE_PATH_STYLE=true

# ── Observability ─────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_grafana_password
