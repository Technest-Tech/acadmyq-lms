# OS
.DS_Store

# Node / pnpm
node_modules/
.pnpm-store/
.next/
out/
*.tsbuildinfo

# Next.js / Vercel
apps/web/.next/
# ...and as a bare path: a dev session may symlink .next out to /tmp (iCloud evicts build
# files), and a trailing-slash pattern does not match a symlink — it would be committed as
# a dangling link and break the prod build.
apps/web/.next
apps/web/out/
apps/web/.vercel/
apps/web/next-env.d.ts

# Env files (secrets live in CI / Vercel / Railway)
.env
.env.*
!.env.example
apps/web/.env*.local

# Laravel
apps/api/vendor/
apps/api/database/*.sqlite
apps/api/storage/*.key
apps/api/.phpunit.cache/
apps/api/.phpunit.result.cache
apps/api/storage/framework/cache/data/*
apps/api/storage/framework/sessions/*
apps/api/storage/framework/views/*
apps/api/storage/logs/*
apps/api/bootstrap/cache/*.php

# Build / coverage
coverage/
*.log

# Local junk / iCloud artifacts (never commit)
apps/api/vendor.broken/
*.icloudpin.tmp
/package-lock.json
/teachers.mp4
