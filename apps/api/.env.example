APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Supabase: SESSION-MODE pooler (5432) or direct connection — NOT transaction-mode (6543).
# Append ?sslmode=require. If set, DB_URL takes precedence over the DB_* parts below.
# DB_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?sslmode=require
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=academiq
# RLS requires the app to connect as a NON-superuser, NON-BYPASSRLS role that OWNS the
# tables, so FORCE ROW LEVEL SECURITY actually applies to it. Provision locally with
# database/bootstrap/roles_and_databases.sql. On Supabase use the project's app role.
DB_USERNAME=academiq_app
DB_PASSWORD=academiq
# NOLOGIN, BYPASSRLS role that owns the SECURITY DEFINER escape-hatch functions.
DB_RLS_BYPASS_ROLE=academiq_rls_bypass

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# The framework session store is renamed away from `sessions` because the domain owns a
# `sessions` table (concrete lesson occurrences, §6.5). Keep these in sync.
SESSION_TABLE=user_sessions
# Prod (Sanctum SPA cookie auth): shared registrable parent, e.g. .academiq.com
SESSION_DOMAIN=null

# --- Auth / CORS ---
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Self-hosted WhatsApp gateway (apps/wa-gateway) ---
# SEND surface (WasenderClient) — in prod this is the gateway's PRIVATE VPC address.
WASENDER_BASE_URL=http://127.0.0.1:8088
WASENDER_TIMEOUT=15
# LIFECYCLE (Super Admin) + webhook secrets — must match the gateway's env.
WA_GATEWAY_URL=http://127.0.0.1:8088
WA_GATEWAY_ADMIN_SECRET=
WA_WEBHOOK_SECRET=
WA_GATEWAY_TIMEOUT=15

VITE_APP_NAME="${APP_NAME}"
