{
  "name": "@academiq/wa-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted WhatsApp gateway (Baileys) — replaces the paid Wasender SaaS. Holds one Baileys socket per academy, API-compatible with the Laravel WasenderClient.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "migrate:dev": "node --import tsx src/migrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "baileys": "6.7.23",
    "fastify": "5.8.5",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "qrcode": "1.5.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.5",
    "pino-pretty": "13.1.3",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  }
}
