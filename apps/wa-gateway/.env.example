# ── WhatsApp Gateway configuration ─────────────────────────────────────────
NODE_ENV=development

# Bind to 127.0.0.1 in dev. In production bind to the VPC PRIVATE interface IP so the gateway
# is never reachable from the public internet (firewall also restricts to the app droplet).
BIND_ADDR=127.0.0.1
PORT=8088

# Gateway's own local Postgres (NOT the app DB).
DATABASE_URL=postgres://wagateway:CHANGE_ME@127.0.0.1:5432/wa_gateway

# Secret authorising Super-Admin lifecycle calls (Laravel -> gateway /sessions*). >= 16 chars.
GATEWAY_ADMIN_SECRET=CHANGE_ME_admin_secret_min_16_chars

# HMAC secret for signing webhooks (gateway -> Laravel). Must match Laravel's WA_WEBHOOK_SECRET.
WEBHOOK_SIGNING_SECRET=CHANGE_ME_webhook_secret_min_16_chars

# Where Laravel receives webhooks (note the /api prefix). Leave blank to run headless.
LARAVEL_WEBHOOK_URL=https://api.acadmyq.com/api/internal/wa/webhook

LOG_LEVEL=info

# ── Anti-ban send pacing (per session) ─────────────────────────────────────
SEND_MIN_INTERVAL_MS=6000
SEND_MAX_INTERVAL_MS=15000
SEND_DAILY_CAP=500
WARMUP_DAYS=3
WARMUP_DAILY_CAP=40
WARMUP_MIN_INTERVAL_MS=20000
WARMUP_MAX_INTERVAL_MS=45000

# ── Reconnection / health ──────────────────────────────────────────────────
KEEPALIVE_MS=25000
RECONNECT_BASE_MS=1000
RECONNECT_CAP_MS=60000
WATCHDOG_INTERVAL_MS=30000
WATCHDOG_STALE_MS=90000

# ── Proxies (one address per academy) ───────────────────────────────────────
# Empty = every number dials WhatsApp from this server's own address (as before).
# Set to a comma-separated list and each academy is pinned to one proxy for good:
#   PROXY_URLS=http://user:pass@1.2.3.4:8000,socks5://user:pass@5.6.7.8:1080
# STATIC addresses only (static residential / ISP). Never a rotating pool: a number whose address
# changes mid-session is worse off than one on a datacenter IP. A proxy that is down takes its
# numbers down with it — there is no fallback to the server's address, on purpose.
PROXY_URLS=

# ── Backups (deploy/bin/wa-gateway-backup.sh, hourly from /etc/cron.d) ──────
# rsync target for a copy off this server, e.g. backup@10.0.0.2:/var/backups/wa-gateway/
# Empty = dumps stay on this server only, which does not survive losing this server.
WA_BACKUP_REMOTE=
