# ── WhatsApp Gateway configuration ─────────────────────────────────────────
NODE_ENV=development

# Bind to 127.0.0.1 in dev. In production bind to the VPC PRIVATE interface IP so the gateway
# is never reachable from the public internet (firewall also restricts to the app droplet).
BIND_ADDR=127.0.0.1
PORT=8088

# Gateway's own local Postgres (NOT the app DB).
DATABASE_URL=postgres://wagateway:CHANGE_ME@127.0.0.1:5432/wa_gateway

# Secret authorising Super-Admin lifecycle calls (Laravel -> gateway /sessions*). >= 16 chars.
GATEWAY_ADMIN_SECRET=CHANGE_ME_admin_secret_min_16_chars

# HMAC secret for signing webhooks (gateway -> Laravel). Must match Laravel's WA_WEBHOOK_SECRET.
WEBHOOK_SIGNING_SECRET=CHANGE_ME_webhook_secret_min_16_chars

# Where Laravel receives webhooks. Leave blank to run headless (no webhooks).
LARAVEL_WEBHOOK_URL=https://api.acadmyq.com/internal/wa/webhook

LOG_LEVEL=info

# ── Anti-ban send pacing (per session) ─────────────────────────────────────
SEND_MIN_INTERVAL_MS=6000
SEND_MAX_INTERVAL_MS=15000
SEND_DAILY_CAP=500
WARMUP_DAYS=3
WARMUP_DAILY_CAP=40
WARMUP_MIN_INTERVAL_MS=20000
WARMUP_MAX_INTERVAL_MS=45000

# ── Reconnection / health ──────────────────────────────────────────────────
KEEPALIVE_MS=10000
RECONNECT_BASE_MS=1000
RECONNECT_CAP_MS=60000
WATCHDOG_INTERVAL_MS=30000
WATCHDOG_STALE_MS=90000
