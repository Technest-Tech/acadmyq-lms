# Base URL of the Laravel API. Local: http://localhost:8000 ; prod: https://api.academiq.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth strategy (decided in Sprint 0 — see lib/api.ts):
#   cookie = Sanctum SPA cookie auth (requires shared parent domain, e.g. .academiq.com)
#   token  = Sanctum bearer-token fallback (no shared domain needed)
NEXT_PUBLIC_AUTH_MODE=cookie
