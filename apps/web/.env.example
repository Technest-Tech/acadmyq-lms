# Base URL of the Laravel API. Local: http://localhost:8000 ; prod: https://api.academiq.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth strategy (decided in Sprint 0 — see lib/api.ts):
#   cookie = Sanctum SPA cookie auth (requires shared parent domain, e.g. .academiq.com)
#   token  = Sanctum bearer-token fallback (no shared domain needed)
NEXT_PUBLIC_AUTH_MODE=cookie

# LMS learner-site subdomain routing (docs/lms/02). Unset ⇒ middleware is a pure pass-through and the
# learner site is reachable only at /learn/<academy>. May include a port for local development; host
# matching strips it. Mirror of the API's LMS_SITE_ROOT_DOMAIN / LMS_SITE_SCHEME.
# Local: NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000 + NEXT_PUBLIC_ROOT_SCHEME=http
NEXT_PUBLIC_ROOT_DOMAIN=
NEXT_PUBLIC_ROOT_SCHEME=https
