# Base URL of the Laravel API. Local: http://localhost:8000 ; prod: https://api.academiq.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth strategy (decided in Sprint 0 — see lib/api.ts):
#   cookie = Sanctum SPA cookie auth (requires shared parent domain, e.g. .academiq.com)
#   token  = Sanctum bearer-token fallback (no shared domain needed)
NEXT_PUBLIC_AUTH_MODE=cookie

# Per-client subdomain routing (docs/lms/02): `<handle>.<root>` serves that client's branded sign-in
# and panel, or their course site when the LMS is their whole product. Unset ⇒ middleware is a pure
# pass-through and both surfaces are reachable only at /learn/<academy> and /login. May include a
# port for local development; host matching strips it. Mirror of the API's LMS_SITE_ROOT_DOMAIN.
#
# Local: use a root with a REAL registrable parent, and point the API at the same one —
#   NEXT_PUBLIC_ROOT_DOMAIN=lvh.me:3000 + NEXT_PUBLIC_ROOT_SCHEME=http
#   NEXT_PUBLIC_API_URL=http://lvh.me:8000
# `lvh.me` and every `*.lvh.me` are public DNS pointing at 127.0.0.1 (no /etc/hosts). `*.localhost`
# renders fine but CANNOT sign in: Chrome counts `x.localhost` and `localhost` as different sites, so
# the session cookie is never sent. See apps/api/.env.example for the API half.
NEXT_PUBLIC_ROOT_DOMAIN=
NEXT_PUBLIC_ROOT_SCHEME=https

# ── Marketing site contact details (optional) ─────────────────────────────────
# Published on /contact and in the footer ONLY when set. Left empty, the site says the demo-request
# form is the way to reach us — which is true, and better than printing an address nobody answers.
# The phone is rendered as a plain tel: link; there is no messaging-app branding anywhere on the
# marketing site.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
